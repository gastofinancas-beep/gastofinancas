{
  "auth": {
    "authorizedDomains": [
      "gastofinancas.netlify.app",
      "gen-lang-client-0076762644.firebaseapp.com",
      "localhost"
    ],
    "authDomain": "gastofinancas.netlify.app"
  },
  "entities": {
    "UserFinancialData": {
      "title": "UserFinancialData",
      "description": "Financial records, budget entries, extra income, cards, investments, and wallet state for a user.",
      "type": "object",
      "properties": {
        "expenses": { "type": "array", "description": "List of user expenses" },
        "incomes": { "type": "array", "description": "List of user incomes" },
        "cards": { "type": "array", "description": "List of user credit cards" },
        "people": { "type": "array", "description": "List of split people" },
        "folders": { "type": "array", "description": "Investment folders" },
        "boxes": { "type": "array", "description": "Investment boxes" },
        "paidBills": { "type": "array", "description": "Paid card bills log" },
        "subscriptions": { "type": "array", "description": "Recurring subscriptions" },
        "driverTrips": { "type": "array", "description": "Driver / ride entries" },
        "driverExpenses": { "type": "array", "description": "Driver expenses" },
        "driverGoals": { "type": "object", "description": "Driver financial goals" },
        "extraProfile": { "type": "object", "description": "Extra income profile configuration" },
        "freelanceEntries": { "type": "array", "description": "Freelance entries" },
        "freelanceExpenses": { "type": "array", "description": "Freelance expenses" },
        "freelanceGoals": { "type": "object", "description": "Freelance goals" },
        "walletAccounts": { "type": "array", "description": "Bank and wallet accounts" },
        "walletTransactions": { "type": "array", "description": "Wallet ledger transactions" },
        "profile": { 
          "type": "object", 
          "description": "User profile metadata including contact email, recovery email, Pix keys, and email/push notification preferences" 
        },
        "subscriptionStatus": { "type": "string", "enum": ["free", "trial", "active", "expired", "canceled"], "description": "Current subscription status" },
        "planId": { "type": "string", "description": "Plan identifier" },
        "trialStartDate": { "type": "string", "description": "ISO date when trial started" },
        "trialEndsAt": { "type": "string", "description": "ISO date when trial expires" },
        "subscriptionEndsAt": { "type": "string", "description": "ISO date when paid access expires" },
        "customerId": { "type": "string", "description": "Payment gateway customer identifier" },
        "updatedAt": { "type": "string", "description": "ISO timestamp of last update" }
      }
    },
    "InvestmentBoxHistoryEntry": {
      "title": "InvestmentBoxHistoryEntry",
      "description": "Historical record of deposit or withdraw transaction in an investment box",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["deposit", "withdraw"], "description": "Transaction type" },
        "amount": { "type": "number", "description": "Transaction amount in BRL" },
        "date": { "type": "string", "description": "Transaction date string YYYY-MM-DD" },
        "notes": { "type": "string", "description": "Optional notes or reason for the transaction" },
        "createdAt": { "type": "string", "description": "Server timestamp of creation" }
      },
      "required": ["type", "amount", "date"]
    },
    "ConnectionHealthCheck": {
      "title": "ConnectionHealthCheck",
      "description": "Ping document used to test Firebase backend connection reachability",
      "type": "object",
      "properties": {
        "status": { "type": "string" },
        "timestamp": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/test/{docId}": {
      "schema": "ConnectionHealthCheck",
      "description": "Read-only health check document for validating network connectivity"
    },
    "/users/{userId}": {
      "schema": "UserFinancialData",
      "description": "Stores all personal financial state and user configuration"
    },
    "/users/{userId}/investmentBoxHistory/{boxId}/entries/{entryId}": {
      "schema": "InvestmentBoxHistoryEntry",
      "description": "Subcollection of deposit and withdraw transactions for each individual investment box"
    }
  }
}
