rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function allowedKeys() {
      return ['profile', 'expenses', 'incomes', 'cards', 'people', 'folders', 'boxes',
              'paidBills', 'subscriptions', 'driverTrips', 'driverExpenses', 'driverGoals',
              'extraProfile', 'freelanceEntries', 'freelanceExpenses', 'freelanceGoals',
              'walletAccounts', 'walletTransactions', 'monthlyTargets', 'accumulationGoals',
              'updatedAt'];
    }

    function listOk(k) {
      return !(k in request.resource.data) || request.resource.data[k] is list;
    }

    function mapOk(k) {
      return !(k in request.resource.data) || request.resource.data[k] is map;
    }

    function shapeOk() {
      return listOk('expenses') && listOk('incomes') && listOk('cards')
        && listOk('people') && listOk('folders') && listOk('boxes')
        && listOk('paidBills') && listOk('subscriptions')
        && listOk('driverTrips') && listOk('driverExpenses')
        && listOk('freelanceEntries') && listOk('freelanceExpenses')
        && listOk('walletAccounts') && listOk('walletTransactions')
        && listOk('accumulationGoals')
        && mapOk('profile') && mapOk('driverGoals') && mapOk('extraProfile')
        && mapOk('freelanceGoals') && mapOk('monthlyTargets')
        && (!('updatedAt' in request.resource.data)
            || (request.resource.data.updatedAt is string
                && request.resource.data.updatedAt.size() <= 40));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(allowedKeys())
        && shapeOk();

      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys())
        && shapeOk();

      allow delete: if isOwner(userId);

      match /investmentBoxHistory/{boxId}/entries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['type', 'amount', 'date', 'notes', 'createdAt'])
          && request.resource.data.type in ['deposit', 'withdraw']
          && request.resource.data.amount is number
          && request.resource.data.date is string
          && request.resource.data.date.size() <= 40
          && (!('notes' in request.resource.data)
              || (request.resource.data.notes is string
                  && request.resource.data.notes.size() <= 1000));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
